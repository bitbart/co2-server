<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<configuration scan="true">
	
	<property name="SWEETLOG_FILE" value="${catalina.base}/logs/middleware/middleware.html"/>
	<property name="GLOBAL_LOG_FILE" value="${catalina.base}/logs/middleware/middleware.log" />
	
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<!-- encoders are assigned the type ch.qos.logback.classic.encoder.PatternLayoutEncoder 
			by default -->
		<encoder>
			<pattern>%d [%thread] %-5level %logger{36} - %method - %msg%n</pattern>
		</encoder>
	</appender>
	
	<appender name="GLOBAL_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${GLOBAL_LOG_FILE}</file>
	
		<encoder>
			<pattern>%d [%thread] %-5level %logger{36} - %method - %msg%n</pattern>
		</encoder>
		
		<rollingPolicy
			class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<!-- rollover daily -->
			<fileNamePattern>middleware-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<!-- each file should be at most 100MB, keep 60 days worth of history, but at most 20GB -->
			<maxFileSize>100MB</maxFileSize>
			<maxHistory>30</maxHistory>
			<totalSizeCap>20GB</totalSizeCap>
		</rollingPolicy>		
		
	</appender>

	<appender name="SWEETLOG" class="ch.qos.logback.core.FileAppender">
		<file>${SWEETLOG_FILE}</file>
		
		<!-- delete the file each time the middleware restart-->
		<append>false</append>
		
		<encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
			<layout class="it.unica.tcs.logging.LogbackLayout" />
		</encoder>


	</appender>


	<root level="debug">
		<appender-ref ref="STDOUT" />
		<appender-ref ref="GLOBAL_LOG" />
		<appender-ref ref="SWEETLOG" />
	</root>
		
</configuration>